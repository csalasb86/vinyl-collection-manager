<h1 class="font-display text-3xl font-extrabold tracking-tight mb-1"><%= t("vinyl_collection.albums.discogs.heading") %></h1>
<p class="text-fg-muted mb-6"><%= t("vinyl_collection.albums.discogs.subtitle") %></p>

<% unless current_user.discogs_authenticated? %>
  <div role="status" class="flex items-start gap-3 p-4 mb-6 rounded-sleeve border border-line bg-surface-2">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-fg-subtle shrink-0 mt-0.5" aria-hidden="true">
      <circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/>
    </svg>
    <p class="text-sm text-fg-muted">
      <%# The _html suffix makes Rails treat this key as safe and escape the
          interpolations, so no html_safe call is needed here. %>
      <%= t("vinyl_collection.albums.discogs.not_connected_html",
            link: link_to(t("vinyl_collection.albums.discogs.not_connected_link"),
                          edit_user_registration_path, class: "text-accent hover:underline")) %>
    </p>
  </div>
<% end %>

<%= form_with url: search_discogs_albums_path, method: :get, class: "flex flex-wrap gap-2 mb-6" do |f| %>
  <label class="flex items-center gap-2 flex-1 min-w-56 px-3 py-2 bg-surface border border-line rounded-sleeve focus-within:border-accent">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-fg-subtle shrink-0" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
    </svg>
    <span class="sr-only"><%= t("vinyl_collection.albums.discogs.search_label") %></span>
    <%= f.search_field :query, value: @query, required: true,
          placeholder: t("vinyl_collection.albums.discogs.search_placeholder"),
          class: "w-full bg-transparent text-fg placeholder:text-fg-subtle focus:outline-none" %>
  </label>
  <%= f.submit t("vinyl_collection.albums.discogs.search"), class: "btn btn-primary" %>
<% end %>

<% if @results.respond_to?(:results) && @results.results.any? %>
  <h2 class="font-display text-[11px] tracking-widest uppercase text-fg-subtle mb-3"><%= t("vinyl_collection.albums.discogs.results") %></h2>

  <ul class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
    <% @results.results.each do |result| %>
      <li class="flex gap-3 p-3 bg-surface border border-line rounded-sleeve">
        <% if result.thumb.present? %>
          <%= image_tag result.thumb, alt: "", aria: { hidden: true }, loading: "lazy",
                class: "w-20 h-20 object-cover rounded-sleeve border border-line shrink-0" %>
        <% else %>
          <div class="w-20 h-20 shrink-0 grid place-items-center bg-surface-2 border border-line rounded-sleeve">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" class="text-line-strong" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.4"/>
              <circle cx="12" cy="12" r="1.6" fill="currentColor"/>
            </svg>
          </div>
        <% end %>

        <div class="min-w-0 flex-1 flex flex-col">
          <h3 class="text-sm font-semibold leading-snug line-clamp-2"><%= result.title %></h3>
          <p class="mt-1 font-mono text-xs text-fg-subtle tabular-nums">
            <%= [ result.year.presence, Array(result.format).presence&.join(", ") ].compact.join(" · ") %>
          </p>

          <%= button_to import_from_discogs_albums_path(discogs_id: result.id, query: @query),
                form_class: "mt-auto pt-2",
                data: { turbo_submits_with: t("vinyl_collection.albums.discogs.importing") },
                class: "btn btn-primary px-3 py-1.5 text-xs",
                aria: { label: t("vinyl_collection.albums.discogs.import_aria", title: result.title) } do %>
            <%= t("vinyl_collection.albums.discogs.import") %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>

  <% if @results.pagination.pages > 1 %>
    <nav class="flex justify-center items-center gap-1 mt-8 text-sm font-medium" aria-label="<%= t("vinyl_collection.albums.discogs.pages_label") %>">
      <% if @results.pagination.page > 1 %>
        <%= link_to t("vinyl_collection.albums.discogs.previous"), search_discogs_albums_path(query: @query, page: @results.pagination.page - 1),
              class: "btn btn-secondary" %>
      <% end %>
      <span class="px-3 py-2 font-mono text-xs text-fg-subtle tabular-nums">
        <%= t("vinyl_collection.albums.discogs.page_of", page: @results.pagination.page, pages: @results.pagination.pages) %>
      </span>
      <% if @results.pagination.page < @results.pagination.pages %>
        <%= link_to t("vinyl_collection.albums.discogs.next"), search_discogs_albums_path(query: @query, page: @results.pagination.page + 1),
              class: "btn btn-secondary" %>
      <% end %>
    </nav>
  <% end %>

<% elsif @query.present? && current_user.discogs_authenticated? %>
  <div class="flex flex-col items-center text-center py-16 px-6 border border-line border-dashed rounded-sleeve">
    <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="text-fg-subtle mb-4" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
    </svg>
    <h2 class="font-display text-2xl font-bold"><%= t("vinyl_collection.albums.discogs.empty_title") %></h2>
    <p class="mt-2 text-fg-muted max-w-prose"><%= t("vinyl_collection.albums.discogs.empty_body", query: @query) %></p>
  </div>
<% end %>

<%= form_with(model: album, class: "space-y-6") do |f| %>
  <% if album.errors.any? %>
    <div role="alert" class="p-4 rounded-sleeve border border-danger bg-danger-soft text-danger">
      <p class="font-semibold mb-1"><%= t("vinyl_collection.albums.form.errors", count: album.errors.count) %></p>
      <ul class="list-disc pl-5 text-sm">
        <% album.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div class="md:col-span-2">
      <%= f.label :title, class: "field-label" %>
      <%= f.text_field :title, required: true, class: "field" %>
    </div>

    <div>
      <%= f.label :year, class: "field-label" %>
      <%= f.number_field :year, min: 1900, max: Time.current.year, class: "field" %>
      <p class="field-help"><%= t("vinyl_collection.albums.form.year_help") %></p>
    </div>

    <div>
      <%= f.label :format, class: "field-label" %>
      <%= f.select :format, [ "Vinyl", "LP", '7"', '10"', '12"', "Box Set" ], { include_blank: t("vinyl_collection.albums.form.select_format") }, class: "field" %>
    </div>

    <div>
      <%= f.label :catalog_number, t("vinyl_collection.albums.form.catalog_number"), class: "field-label" %>
      <%= f.text_field :catalog_number, class: "field" %>
    </div>

    <div>
      <%= f.label :artist_ids, t("vinyl_collection.albums.form.artists"), class: "field-label" %>
      <%= f.collection_select :artist_ids, Artist.order(:name), :id, :name, { selected: album.artist_ids }, { multiple: true, size: 5, class: "field" } %>
      <p class="field-help"><%= t("vinyl_collection.albums.form.multiple_help") %></p>
    </div>

    <div class="md:col-span-2">
      <%= f.label :genre, t("vinyl_collection.albums.form.genres"), class: "field-label" %>
      <%= f.select :genre, Album.pluck(:genre).flatten.uniq.sort, { selected: album.genre }, { multiple: true, size: 5, class: "field" } %>
      <p class="field-help"><%= t("vinyl_collection.albums.form.multiple_help") %></p>
    </div>

    <div class="md:col-span-2">
      <%= f.label :cover, t("vinyl_collection.albums.form.cover"), class: "field-label" %>
      <div class="flex items-start gap-4">
        <% if album.cover.attached? %>
          <%= image_tag album.cover_url, alt: cover_alt(album),
                class: "w-24 h-24 object-cover rounded-sleeve border border-line shrink-0" %>
        <% else %>
          <div class="w-24 h-24 shrink-0 grid place-items-center bg-surface-2 border border-line rounded-sleeve">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" class="text-line-strong" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.4"/>
              <circle cx="12" cy="12" r="1.6" fill="currentColor"/>
            </svg>
          </div>
        <% end %>
        <div class="min-w-0 flex-1">
          <%= f.file_field :cover, direct_upload: true, accept: "image/*", class: "field" %>
          <p class="field-help">
            <%= album.cover.attached? ? t("vinyl_collection.albums.form.cover_replace") : t("vinyl_collection.albums.form.cover_hint") %>
          </p>
        </div>
      </div>
    </div>

    <div class="md:col-span-2">
      <%= f.label :notes, class: "field-label" %>
      <%= f.text_area :notes, rows: 5, class: "field" %>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-2 border-t border-line">
    <%= f.submit t("vinyl_collection.albums.form.#{album.persisted? ? "update" : "create"}"),
          class: "btn btn-primary" %>
    <%= link_to t("vinyl_collection.albums.form.cancel"),
          album.persisted? ? album_path(album) : albums_path,
          class: "btn btn-ghost" %>
  </div>
<% end %>

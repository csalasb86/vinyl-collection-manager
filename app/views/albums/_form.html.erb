<%= form_with(model: album, local: true, class: "space-y-6") do |f| %>
  <% if album.errors.any? %>
    <div class="p-4 bg-danger-soft text-danger rounded-sleeve">
      <h2><%= pluralize(album.errors.count, "error") %> prohibited this album from being saved:</h2>
      <ul class="list-disc pl-5">
        <% album.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= f.label :title, class: "block text-sm font-medium text-fg-muted mb-1" %>
      <%= f.text_field :title, class: "w-full px-3 py-2 border border-line rounded-sleeve" %>
    </div>
    
    <div>
      <%= f.label :year, class: "block text-sm font-medium text-fg-muted mb-1" %>
      <%= f.number_field :year, min: 1900, max: Time.current.year, class: "w-full px-3 py-2 border border-line rounded-sleeve" %>
    </div>
    <div>
      <%= f.label :format, class: "block text-sm font-medium text-fg-muted mb-1" %>
      <%= f.select :format, ['Vinyl', 'LP', '7"', '10"', '12"', 'Box Set'], { include_blank: "Select Format" }, class: "w-full px-3 py-2 border border-line rounded-sleeve" %>
    </div>
    
    <div>
      <%= f.label :catalog_number, class: "block text-sm font-medium text-fg-muted mb-1" %>
      <%= f.text_field :catalog_number, class: "w-full px-3 py-2 border border-line rounded-sleeve" %>
    </div>
    
    <div>
      <%= f.label :cover, class: "block text-sm font-medium text-fg-muted mb-1" %>
      <%= f.file_field :cover, direct_upload: true, accept: 'image/*', class: "w-full px-3 py-2 border border-line rounded-sleeve" %>
      <% if album.cover.attached? %>
        <div class="mt-2">
          <%= image_tag album.cover_url, class: "h-24 w-24 object-cover rounded-sleeve" %>
          <p class="text-xs text-fg-subtle">Current cover will be replaced if you select a new file</p>
        </div>
      <% end %>
    </div>
    
    <div class="md:col-span-2">
      <%= f.label :artist_ids, "Artists", class: "block text-sm font-medium text-fg-muted mb-1" %>
      <%= f.collection_select :artist_ids, Artist.order(:name), :id, :name, { selected: album.artist_ids }, { multiple: true, class: "w-full px-3 py-2 border border-line rounded-sleeve" } %>
      <p class="text-xs text-fg-subtle mt-1">Hold Ctrl/Cmd to select multiple artists</p>
    </div>
    
    <div class="md:col-span-2">
      <%= f.label :genre, "Genres", class: "block text-sm font-medium text-fg-muted mb-1" %>
      <%= f.select :genre, Album.pluck(:genre).flatten.uniq.sort, { selected: album.genre }, { multiple: true, class: "w-full px-3 py-2 border border-line rounded-sleeve" } %>
      <p class="text-xs text-fg-subtle mt-1">Hold Ctrl/Cmd to select multiple genres</p>
    </div>
    
    <div class="md:col-span-2">
      <%= f.label :notes, class: "block text-sm font-medium text-fg-muted mb-1" %>
      <%= f.text_area :notes, rows: 5, class: "w-full px-3 py-2 border border-line rounded-sleeve" %>
    </div>
  </div>
  
  <div class="flex justify-end space-x-2">
    <%= link_to "Cancel", album.persisted? ? album_path(album) : albums_path, class: "px-4 py-2 bg-surface-3 text-fg rounded-sleeve hover:bg-line" %>
    <%= f.submit class: "px-4 py-2 bg-accent text-accent-fg rounded-sleeve hover:bg-accent-hover" %>
  </div>
<% end %>
<%= form_with(model: album, class: "space-y-6") do |f| %>
  <% if album.errors.any? %>
    <div role="alert" class="p-4 rounded-sleeve border border-danger bg-danger-soft text-danger">
      <p class="font-semibold mb-1"><%= pluralize(album.errors.count, "problem") %> stopped this from saving</p>
      <ul class="list-disc pl-5 text-sm">
        <% album.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div class="md:col-span-2">
      <%= f.label :title, class: form_label_classes %>
      <%= f.text_field :title, required: true, class: form_input_classes %>
    </div>

    <div>
      <%= f.label :year, class: form_label_classes %>
      <%= f.number_field :year, min: 1900, max: Time.current.year, class: form_input_classes %>
      <p class="<%= help_text_classes %>">Leave blank if the pressing year is unknown.</p>
    </div>

    <div>
      <%= f.label :format, class: form_label_classes %>
      <%= f.select :format, [ "Vinyl", "LP", '7"', '10"', '12"', "Box Set" ], { include_blank: "Select format" }, class: form_input_classes %>
    </div>

    <div>
      <%= f.label :catalog_number, "Catalog number", class: form_label_classes %>
      <%= f.text_field :catalog_number, class: form_input_classes %>
    </div>

    <div>
      <%= f.label :artist_ids, "Artists", class: form_label_classes %>
      <%= f.collection_select :artist_ids, Artist.order(:name), :id, :name, { selected: album.artist_ids }, { multiple: true, size: 5, class: form_input_classes } %>
      <p class="<%= help_text_classes %>">Hold Ctrl or Cmd to pick more than one.</p>
    </div>

    <div class="md:col-span-2">
      <%= f.label :genre, "Genres", class: form_label_classes %>
      <%= f.select :genre, Album.pluck(:genre).flatten.uniq.sort, { selected: album.genre }, { multiple: true, size: 5, class: form_input_classes } %>
      <p class="<%= help_text_classes %>">Hold Ctrl or Cmd to pick more than one.</p>
    </div>

    <div class="md:col-span-2">
      <%= f.label :cover, "Cover art", class: form_label_classes %>
      <div class="flex items-start gap-4">
        <% if album.cover.attached? %>
          <%= image_tag album.cover_url, alt: cover_alt(album),
                class: "w-24 h-24 object-cover rounded-sleeve border border-line shrink-0" %>
        <% else %>
          <div class="w-24 h-24 shrink-0 grid place-items-center bg-surface-2 border border-line rounded-sleeve">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" class="text-line-strong" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.4"/>
              <circle cx="12" cy="12" r="1.6" fill="currentColor"/>
            </svg>
          </div>
        <% end %>
        <div class="min-w-0 flex-1">
          <%= f.file_field :cover, direct_upload: true, accept: "image/*", class: form_input_classes %>
          <p class="<%= help_text_classes %>">
            <%= album.cover.attached? ? "Choosing a file replaces the current cover." : "JPEG or PNG, square works best." %>
          </p>
        </div>
      </div>
    </div>

    <div class="md:col-span-2">
      <%= f.label :notes, class: form_label_classes %>
      <%= f.text_area :notes, rows: 5, class: form_input_classes %>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-2 border-t border-line">
    <%= f.submit (album.persisted? ? "Save changes" : "Add to collection"),
          class: "px-4 py-2 rounded-sleeve bg-accent text-accent-fg font-medium hover:bg-accent-hover cursor-pointer" %>
    <%= link_to "Cancel", album.persisted? ? album_path(album) : albums_path,
          class: "px-4 py-2 rounded-sleeve text-fg-muted hover:bg-surface-2 hover:text-fg" %>
  </div>
<% end %>

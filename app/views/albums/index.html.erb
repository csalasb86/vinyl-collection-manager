<%# The nav already marks this section as current and the grid speaks for
    itself, so the heading is there for the document outline, not the layout. %>
<h1 class="sr-only"><%= t("vinyl_collection.albums.index.heading") %></h1>

<%# The toolbar sits outside the frame on purpose: replacing it on every
    keystroke would take the focus out of the search field. %>
<div class="relative flex flex-wrap items-start gap-2 mb-5">
  <%= form_with url: albums_path, method: :get,
                data: { controller: "autosubmit", turbo_frame: "albums" },
                class: "contents" do |f| %>

    <label class="flex items-center gap-2 basis-full sm:basis-auto sm:flex-1 min-w-0 min-h-11 px-3 bg-surface border border-line rounded-sleeve focus-within:border-accent">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-fg-subtle shrink-0" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
      </svg>
      <span class="sr-only"><%= t("vinyl_collection.albums.index.search_label") %></span>
      <%= f.search_field :q, value: @q,
            placeholder: t("vinyl_collection.albums.index.search_placeholder"),
            autocomplete: "off",
            data: { action: "input->autosubmit#debounced" },
            class: "w-full bg-transparent text-fg placeholder:text-fg-subtle focus:outline-none" %>
    </label>

    <%# Not auto-opened on a filtered URL: the panel overlays the results, so it
        would land right on top of the chips it is meant to explain. %>
    <details>
      <summary class="flex items-center gap-2 min-h-11 px-3 rounded-sleeve border border-line bg-surface text-sm text-fg cursor-pointer select-none hover:bg-surface-2 marker:content-none [&::-webkit-details-marker]:hidden">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 5h18M6 12h12M10 19h4"/>
        </svg>
        <%# No count badge here: the toolbar sits outside the frame, so it would
            go stale the moment a filter is applied. The chips under it are
            inside the frame and always current. %>
        <%= t("vinyl_collection.albums.index.filters") %>
      </summary>

      <div class="absolute left-0 right-0 top-full z-30 mt-2 p-4 bg-surface border border-line rounded-sleeve shadow-md">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <%= f.label :year, t("vinyl_collection.albums.index.year"), class: "field-label" %>
            <%= f.select :year, options_for_select(@years, @year), { include_blank: t("vinyl_collection.albums.index.all_years") },
                  data: { action: "change->autosubmit#now" }, class: "field" %>
          </div>
          <div>
            <%= f.label :genre, t("vinyl_collection.albums.index.genre"), class: "field-label" %>
            <%= f.select :genre, options_for_select(@genres, @genre), { include_blank: t("vinyl_collection.albums.index.all_genres") },
                  data: { action: "change->autosubmit#now" }, class: "field" %>
          </div>
          <div>
            <%= f.label :artist_id, t("vinyl_collection.albums.index.artist"), class: "field-label" %>
            <%= f.select :artist_id, options_from_collection_for_select(@artists, :id, :name, @artist_id), { include_blank: t("vinyl_collection.albums.index.all_artists") },
                  data: { action: "change->autosubmit#now" }, class: "field" %>
          </div>
          <div>
            <%= f.label :format, t("vinyl_collection.albums.index.format"), class: "field-label" %>
            <%= f.select :format, options_for_select(@formats, @format), { include_blank: t("vinyl_collection.albums.index.all_formats") },
                  data: { action: "change->autosubmit#now" }, class: "field" %>
          </div>
        </div>

        <div class="flex justify-end gap-2 mt-4">
          <%= link_to t("vinyl_collection.albums.index.clear_all"), path_without_filters,
                data: { turbo_frame: "_top" }, class: "btn btn-ghost" %>
          <%# Without JS this button is how filters get applied. %>
          <%= f.submit t("vinyl_collection.albums.index.apply"), class: "btn btn-primary" %>
        </div>
      </div>
    </details>

    <div>
      <label class="sr-only" for="sort"><%= t("vinyl_collection.albums.index.sort_label") %></label>
      <%= f.select :sort, options_for_select(sort_options, @sort), {},
            id: "sort",
            data: { action: "change->autosubmit#now" },
            class: "max-w-40 sm:max-w-none min-h-11 px-3 bg-surface border border-line rounded-sleeve text-sm text-fg" %>
    </div>
  <% end %>

  <%# Icon only on a phone, where the label costs a whole toolbar row. The
      accessible name stays either way. %>
  <%= link_to new_album_path, aria: { label: t("vinyl_collection.albums.index.add") },
        class: "btn btn-primary ml-auto px-3" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
      <path d="M12 5v14M5 12h14"/>
    </svg>
    <span class="hidden sm:inline"><%= t("vinyl_collection.albums.index.add") %></span>
  <% end %>
</div>

<%# target: "_top" so a link inside the results navigates the page rather than
    trying to render the next page inside this frame. Pagination opts back in
    through Pagy's link_extra in the controller. %>
<%= turbo_frame_tag "albums", target: "_top", data: { turbo_action: "advance" } do %>
  <%= render "albums/results" %>
<% end %>

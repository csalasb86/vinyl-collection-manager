<div class="mb-6">
  <h1 class="text-3xl font-bold mb-6">Your Vinyl Collection</h1>
  
  <div class="bg-surface p-4 rounded-sleeve shadow mb-6">
    <h2 class="text-xl font-semibold mb-4">Filter Collection</h2>
    
    <%= form_with url: albums_path, method: :get, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
        <div>
          <%= f.label :q, "Search", class: "block text-sm font-medium text-fg-muted mb-1" %>
          <%= f.text_field :q, value: @q, placeholder: "Search title or artist...", class: "w-full px-3 py-2 border border-line rounded-sleeve" %>
        </div>
        
        <div>
          <%= f.label :year, "Year", class: "block text-sm font-medium text-fg-muted mb-1" %>
          <%= f.select :year, options_for_select(@years, @year), { include_blank: "All Years" }, class: "w-full px-3 py-2 border border-line rounded-sleeve" %>
        </div>
        
        <div>
          <%= f.label :genre, "Genre", class: "block text-sm font-medium text-fg-muted mb-1" %>
          <%= f.select :genre, options_for_select(@genres, @genre), { include_blank: "All Genres" }, class: "w-full px-3 py-2 border border-line rounded-sleeve" %>
        </div>
        
        <div>
          <%= f.label :artist_id, "Artist", class: "block text-sm font-medium text-fg-muted mb-1" %>
          <%= f.select :artist_id, options_from_collection_for_select(@artists, :id, :name, @artist_id), { include_blank: "All Artists" }, class: "w-full px-3 py-2 border border-line rounded-sleeve" %>
        </div>
        
        <div>
          <%= f.label :format, "Format", class: "block text-sm font-medium text-fg-muted mb-1" %>
          <%= f.select :format, options_for_select(@formats, @format), { include_blank: "All Formats" }, class: "w-full px-3 py-2 border border-line rounded-sleeve" %>
        </div>
      </div>
      
      <div class="flex justify-end">
        <%= f.submit "Filter", class: "px-4 py-2 bg-accent text-accent-fg rounded-sleeve hover:bg-accent-hover" %>
        <%= link_to "Clear", albums_path, class: "ml-2 px-4 py-2 bg-surface-3 text-fg rounded-sleeve hover:bg-line" %>
      </div>
    <% end %>
  </div>
  
  <div class="flex justify-between items-center mb-4">
    <p class="text-fg-muted"><%= pluralize(@pagy.count, 'album') %> found</p>
    <%= link_to "Add New Album", new_album_path, class: "px-4 py-2 bg-ok text-surface rounded-sleeve hover:bg-ok-hover" %>
  </div>
  
  <% if @albums.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-6">
      <% @albums.each do |album| %>
        <div class="bg-surface rounded-sleeve shadow overflow-hidden hover:shadow-lg transition duration-300">
          <%= link_to album do %>
            <div class="aspect-square overflow-hidden">
              <% if album.cover.attached? %>
                <%= image_tag album.cover_url, class: "w-full h-full object-cover" %>
              <% else %>
                <div class="w-full h-full bg-surface-3 flex items-center justify-center">
                  <span class="text-fg-subtle">No Cover</span>
                </div>
              <% end %>
            </div>
            <div class="p-3">
              <h3 class="font-semibold text-sm truncate"><%= album.title %></h3>
              <p class="text-xs text-fg-muted truncate"><%= album.display_artists %></p>
              <p class="text-xs text-fg-subtle mt-1"><%= [ album.year, album.format ].compact_blank.join(" · ") %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    
    <div class="mt-6">
      <%== pagy_nav(@pagy) %>
    </div>
  <% else %>
    <div class="bg-surface p-6 rounded-sleeve shadow text-center">
      <p class="text-fg-muted mb-4">No albums found matching your filters.</p>
      <%= link_to "Clear Filters", albums_path, class: "px-4 py-2 bg-accent text-accent-fg rounded-sleeve hover:bg-accent-hover" %>
    </div>
  <% end %>
</div>
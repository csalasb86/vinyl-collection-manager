<div class="mb-6">
  <h1 class="text-3xl font-bold mb-6">Your Vinyl Collection</h1>
  
  <div class="bg-white p-4 rounded-lg shadow mb-6">
    <h2 class="text-xl font-semibold mb-4">Filter Collection</h2>
    
    <%= form_with url: albums_path, method: :get, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
        <div>
          <%= f.label :q, "Search", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :q, value: @q, placeholder: "Search title or artist...", class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
        
        <div>
          <%= f.label :year, "Year", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :year, options_for_select(@years, @year), { include_blank: "All Years" }, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
        
        <div>
          <%= f.label :genre, "Genre", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :genre, options_for_select(@genres, @genre), { include_blank: "All Genres" }, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
        
        <div>
          <%= f.label :artist_id, "Artist", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :artist_id, options_from_collection_for_select(@artists, :id, :name, @artist_id), { include_blank: "All Artists" }, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
        
        <div>
          <%= f.label :format, "Format", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :format, options_for_select(@formats, @format), { include_blank: "All Formats" }, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
      </div>
      
      <div class="flex justify-end">
        <%= f.submit "Filter", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
        <%= link_to "Clear", albums_path, class: "ml-2 px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300" %>
      </div>
    <% end %>
  </div>
  
  <div class="flex justify-between items-center mb-4">
    <p class="text-gray-600"><%= pluralize(@pagy.count, 'album') %> found</p>
    <%= link_to "Add New Album", new_album_path, class: "px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700" %>
  </div>
  
  <% if @albums.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-6">
      <% @albums.each do |album| %>
        <div class="bg-white rounded-lg shadow overflow-hidden hover:shadow-lg transition duration-300">
          <%= link_to album do %>
            <div class="aspect-square overflow-hidden">
              <% if album.cover.attached? %>
                <%= image_tag album.cover_url, class: "w-full h-full object-cover" %>
              <% else %>
                <div class="w-full h-full bg-gray-200 flex items-center justify-center">
                  <span class="text-gray-400">No Cover</span>
                </div>
              <% end %>
            </div>
            <div class="p-3">
              <h3 class="font-semibold text-sm truncate"><%= album.title %></h3>
              <p class="text-xs text-gray-600 truncate"><%= album.display_artists %></p>
              <p class="text-xs text-gray-500 mt-1"><%= album.year %> · <%= album.format %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    
    <div class="mt-6">
      <%== pagy_nav(@pagy) %>
    </div>
  <% else %>
    <div class="bg-white p-6 rounded-lg shadow text-center">
      <p class="text-gray-600 mb-4">No albums found matching your filters.</p>
      <%= link_to "Clear Filters", albums_path, class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
    </div>
  <% end %>
</div>
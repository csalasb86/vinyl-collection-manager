<article class="bg-surface border border-line rounded-sleeve overflow-hidden">
  <div class="relative isolate grid md:grid-cols-[minmax(0,17rem)_1fr] gap-8 p-6 md:p-8 border-b border-line">
    <%# The sleeve tints its own page: the same image, blurred out behind the
        header. Same URL as the cover, so the browser reuses it. %>
    <% if @album.cover.attached? %>
      <%= image_tag @album.cover_url, alt: "", aria: { hidden: true },
            class: "absolute inset-0 -z-10 w-full h-full object-cover scale-110 blur-[64px] saturate-150 opacity-15 dark:opacity-25 pointer-events-none" %>
    <% end %>

    <div>
      <% if @album.cover.attached? %>
        <%= image_tag @album.cover_url, alt: cover_alt(@album),
              class: "w-full aspect-square object-cover rounded-sleeve shadow-md" %>
      <% else %>
        <div class="w-full aspect-square flex flex-col items-center justify-center gap-3 bg-surface-2 border border-line rounded-sleeve">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" class="text-line-strong" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.4"/>
            <circle cx="12" cy="12" r="5.5" stroke="currentColor" stroke-width="1" opacity="0.6"/>
            <circle cx="12" cy="12" r="1.6" fill="currentColor"/>
          </svg>
          <span class="font-display text-[11px] tracking-widest uppercase text-fg-subtle">
            <%= t("vinyl_collection.albums.show.no_cover") %>
          </span>
        </div>
      <% end %>
    </div>

    <div class="min-w-0">
      <% if @album.catalog_number.present? %>
        <p class="font-mono text-xs tracking-wide text-fg-subtle mb-2"><%= @album.catalog_number %></p>
      <% end %>

      <h1 class="font-display text-3xl md:text-4xl font-extrabold tracking-tight leading-none"><%= @album.title %></h1>
      <p class="mt-2 text-lg text-fg-muted"><%= @album.display_artists %></p>

      <% if @album.genre.any? %>
        <div class="flex flex-wrap gap-2 mt-4">
          <h2 class="sr-only"><%= t("vinyl_collection.albums.show.genres") %></h2>
          <% @album.genre.each do |genre| %>
            <%= link_to genre, albums_path(genre: genre),
                  class: "px-3 py-1 rounded-full border border-line-strong text-sm text-fg-muted hover:border-accent hover:text-fg" %>
          <% end %>
        </div>
      <% end %>

      <%# Liner notes: condensed labels, values in tabular mono. %>
      <dl class="grid grid-cols-2 sm:grid-cols-4 mt-6 border-t border-line">
        <div class="py-3 pr-4 border-r border-line">
          <dt class="font-display text-[10px] tracking-widest uppercase text-fg-subtle mb-1"><%= t("vinyl_collection.albums.show.labels.year") %></dt>
          <dd class="font-mono text-sm tabular-nums"><%= @album.year_label %></dd>
        </div>
        <div class="py-3 px-4 sm:border-r border-line">
          <dt class="font-display text-[10px] tracking-widest uppercase text-fg-subtle mb-1"><%= t("vinyl_collection.albums.show.labels.format") %></dt>
          <dd class="font-mono text-sm"><%= @album.format.presence || "—" %></dd>
        </div>
        <div class="py-3 pr-4 sm:px-4 border-r border-line">
          <dt class="font-display text-[10px] tracking-widest uppercase text-fg-subtle mb-1"><%= t("vinyl_collection.albums.show.labels.catalog") %></dt>
          <dd class="font-mono text-sm"><%= @album.catalog_number.presence || "—" %></dd>
        </div>
        <div class="py-3 px-4">
          <dt class="font-display text-[10px] tracking-widest uppercase text-fg-subtle mb-1"><%= t("vinyl_collection.albums.show.labels.discogs") %></dt>
          <dd class="font-mono text-sm tabular-nums">
            <% if @album.discogs_id.present? %>
              <a href="<%= @album.discogs_url %>" target="_blank" rel="noopener noreferrer"
                 class="text-accent hover:underline"
                 aria-label="<%= t("vinyl_collection.albums.show.aria.view_on_discogs", title: @album.title) %>">
                <%= @album.discogs_id %>
              </a>
            <% else %>
              &mdash;
            <% end %>
          </dd>
        </div>
      </dl>

      <%# Weight, not variety: one primary, one secondary, and the destructive
          action pushed away from both so it is never the accidental click. %>
      <div class="flex flex-wrap items-center gap-2 mt-6">
        <%= link_to t("vinyl_collection.albums.show.edit"), edit_album_path(@album),
              class: "btn btn-primary",
              aria: { label: t("vinyl_collection.albums.show.aria.edit_album", title: @album.title) } %>

        <% if @album.discogs_id.present? %>
          <%= link_to refresh_from_discogs_album_path(@album), data: { turbo_method: :patch },
                class: "btn btn-secondary",
                aria: { label: t("vinyl_collection.albums.show.aria.refresh_album", title: @album.title) } do %>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12a9 9 0 11-3-6.7M21 4v5h-5"/>
            </svg>
            <%= t("vinyl_collection.albums.show.refresh_from_discogs") %>
          <% end %>
        <% end %>

        <%= button_to t("vinyl_collection.albums.show.delete"), album_path(@album),
              method: :delete,
              form_class: "ml-auto",
              data: { turbo_confirm: t("vinyl_collection.albums.show.confirm_delete") },
              class: "btn btn-danger",
              aria: { label: t("vinyl_collection.albums.show.aria.delete_album", title: @album.title) } %>
      </div>
    </div>
  </div>

  <% if @album.tracks.any? || @album.notes.present? %>
    <div class="grid lg:grid-cols-[1fr_minmax(0,22rem)] gap-8 p-6 md:p-8">
      <% if @album.tracks.any? %>
        <section>
          <h2 class="font-display text-[11px] tracking-widest uppercase text-fg-subtle mb-3">
            <%= t("vinyl_collection.albums.show.tracklist") %>
          </h2>
          <table class="w-full text-sm" aria-label="<%= t("vinyl_collection.albums.show.aria.album_tracklist") %>">
            <thead class="sr-only">
              <tr>
                <th><%= t("vinyl_collection.albums.show.position") %></th>
                <th><%= t("vinyl_collection.albums.show.title_header") %></th>
                <th><%= t("vinyl_collection.albums.show.duration") %></th>
              </tr>
            </thead>
            <tbody>
              <% @album.tracks.each do |track| %>
                <tr class="border-b border-line hover:bg-surface-2">
                  <td class="py-2.5 pr-4 w-12 font-mono text-xs text-fg-subtle tabular-nums align-baseline"><%= track.position %></td>
                  <td class="py-2.5 pr-4 align-baseline"><%= track.title %></td>
                  <td class="py-2.5 text-right font-mono text-xs text-fg-subtle tabular-nums align-baseline whitespace-nowrap"><%= track.duration %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </section>
      <% end %>

      <% if @album.notes.present? %>
        <section>
          <h2 class="font-display text-[11px] tracking-widest uppercase text-fg-subtle mb-3">
            <%= t("vinyl_collection.albums.show.notes") %>
          </h2>
          <%# break-words: Discogs notes carry bare URLs that would otherwise
              push the column past its edge. %>
          <div class="text-sm text-fg-muted leading-relaxed break-words [&_p]:mb-2">
            <%= simple_format(discogs_notes(@album.notes)) %>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>
</article>

<div class="mt-6">
  <%= link_to albums_path, class: "inline-flex items-center gap-2 text-sm text-fg-muted hover:text-fg" do %>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M15 6l-6 6 6 6"/>
    </svg>
    <%= t("vinyl_collection.albums.show.back_to_collection") %>
  <% end %>
</div>

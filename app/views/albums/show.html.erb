<div class="bg-white rounded-lg shadow overflow-hidden">
  <div class="md:flex">
    <div class="md:w-1/3 p-6">
      <% if @album.cover.attached? %>
        <%= image_tag @album.cover_url, class: "w-full rounded-lg shadow" %>
      <% else %>
        <div class="w-full aspect-square bg-gray-200 rounded-lg flex items-center justify-center">
          <span class="text-gray-400">No Cover</span>
        </div>
      <% end %>
      
      <div class="mt-4 space-y-1">
        <div class="flex justify-between">
          <span class="text-gray-600">Format:</span>
          <span><%= @album.format %></span>
        </div>
        
        <div class="flex justify-between">
          <span class="text-gray-600">Year:</span>
          <span><%= @album.year %></span>
        </div>
        
        <% if @album.catalog_number.present? %>
          <div class="flex justify-between">
            <span class="text-gray-600">Catalog #:</span>
            <span><%= @album.catalog_number %></span>
          </div>
        <% end %>
        
        <% if @album.discogs_id.present? %>
          <div class="flex justify-between">
            <span class="text-gray-600">Discogs ID:</span>
            <a href="<%= @album.discogs_url %>" target="_blank" class="text-blue-600 hover:underline">
              <%= @album.discogs_id %>
            </a>
          </div>
        <% end %>
      </div>
      
      <div class="mt-6 space-x-2 flex">
        <%= link_to "Edit", edit_album_path(@album), class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
        
        <% if @album.discogs_id.present? %>
          <%= link_to "Refresh from Discogs", refresh_from_discogs_album_path(@album), method: :post, class: "px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700" %>
        <% end %>
        
        <%= link_to "Delete", album_path(@album), method: :delete, data: { confirm: "Are you sure you want to delete this album?" }, class: "px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700" %>
      </div>
    </div>
    
    <div class="md:w-2/3 p-6">
      <h1 class="text-3xl font-bold mb-2"><%= @album.title %></h1>
      <h2 class="text-xl text-gray-600 mb-6"><%= @album.display_artists %></h2>
      
      <% if @album.genre.any? %>
        <div class="mb-6">
          <h3 class="text-gray-600 text-sm mb-1">Genres</h3>
          <div class="flex flex-wrap gap-2">
            <% @album.genre.each do |genre| %>
              <%= link_to genre, albums_path(genre: genre), class: "px-3 py-1 bg-gray-200 rounded-full text-sm hover:bg-gray-300" %>
            <% end %>
          </div>
        </div>
      <% end %>
      
      <% if @album.tracks.any? %>
        <div class="mb-6">
          <h3 class="text-lg font-semibold mb-2">Tracklist</h3>
          <table class="w-full">
            <thead class="border-b">
              <tr>
                <th class="text-left pb-2 font-medium">#</th>
                <th class="text-left pb-2 font-medium">Title</th>
                <th class="text-right pb-2 font-medium">Duration</th>
              </tr>
            </thead>
            <tbody>
              <% @album.tracks.each do |track| %>
                <tr class="border-b">
                  <td class="py-2 text-gray-600"><%= track.position %></td>
                  <td class="py-2"><%= track.title %></td>
                  <td class="py-2 text-right text-gray-600"><%= track.duration %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
      
      <% if @album.notes.present? %>
        <div class="mb-6">
          <h3 class="text-lg font-semibold mb-2">Notes</h3>
          <div class="bg-gray-50 p-4 rounded-lg">
            <%= simple_format(@album.notes) %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="mt-6">
  <%= link_to "Back to Collection", albums_path, class: "text-blue-600 hover:underline" %>
</div>
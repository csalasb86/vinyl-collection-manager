<div class="bg-surface rounded-sleeve shadow overflow-hidden">
  <div class="md:flex">
    <div class="md:w-1/3 p-6">
      <% if @album.cover.attached? %>
        <%= image_tag @album.cover_url, class: "w-full rounded-sleeve shadow" %>
      <% else %>
        <div class="w-full aspect-square bg-surface-3 rounded-sleeve flex items-center justify-center">
          <span class="text-fg-subtle"><%= t('vinyl_collection.albums.show.no_cover') %></span>
        </div>
      <% end %>
      
      <div class="mt-4 space-y-1">
        <div class="flex justify-between">
          <span class="text-fg-muted"><%= t('vinyl_collection.albums.show.format') %></span>
          <span><%= @album.format %></span>
        </div>
        
        <div class="flex justify-between">
          <span class="text-fg-muted"><%= t('vinyl_collection.albums.show.year') %></span>
          <span><%= @album.year_label %></span>
        </div>
        
        <% if @album.catalog_number.present? %>
          <div class="flex justify-between">
            <span class="text-fg-muted"><%= t('vinyl_collection.albums.show.catalog_number') %></span>
            <span><%= @album.catalog_number %></span>
          </div>
        <% end %>
        
        <% if @album.discogs_id.present? %>
          <div class="flex justify-between">
            <span class="text-fg-muted"><%= t('vinyl_collection.albums.show.discogs_id') %></span>
            <a href="<%= @album.discogs_url %>" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline" aria-label="<%= t('vinyl_collection.albums.show.aria.view_on_discogs', title: @album.title) %>">
              <%= @album.discogs_id %>
            </a>
          </div>
        <% end %>
      </div>
      
      <div class="mt-6 space-x-2 flex">
        <%= link_to t('vinyl_collection.albums.show.edit'), edit_album_path(@album), class: "px-4 py-2 bg-accent text-accent-fg rounded-sleeve hover:bg-accent-hover", "aria-label": t('vinyl_collection.albums.show.aria.edit_album', title: @album.title) %>
        
        <% if @album.discogs_id.present? %>
          <%= link_to t('vinyl_collection.albums.show.refresh_from_discogs'), refresh_from_discogs_album_path(@album), data: { turbo_method: :patch }, class: "px-4 py-2 bg-ok text-surface rounded-sleeve hover:bg-ok-hover", "aria-label": t('vinyl_collection.albums.show.aria.refresh_album', title: @album.title) %>
        <% end %>
        
        <%= button_to t('vinyl_collection.albums.show.delete'), album_path(@album), method: :delete, data: { turbo_confirm: t('vinyl_collection.albums.show.confirm_delete') }, class: "px-4 py-2 bg-danger text-surface rounded-sleeve hover:bg-danger-hover", "aria-label": t('vinyl_collection.albums.show.aria.delete_album', title: @album.title) %>
      </div>
    </div>
    
    <div class="md:w-2/3 p-6">
      <h1 class="text-3xl font-bold mb-2"><%= @album.title %></h1>
      <h2 class="text-xl text-fg-muted mb-6"><%= @album.display_artists %></h2>
      
      <% if @album.genre.any? %>
        <div class="mb-6">
          <h3 class="text-fg-muted text-sm mb-1"><%= t('vinyl_collection.albums.show.genres') %></h3>
          <div class="flex flex-wrap gap-2">
            <% @album.genre.each do |genre| %>
              <%= link_to genre, albums_path(genre: genre), class: "px-3 py-1 bg-surface-3 rounded-full text-sm hover:bg-line" %>
            <% end %>
          </div>
        </div>
      <% end %>
      
      <% if @album.tracks.any? %>
        <div class="mb-6">
          <h3 class="text-lg font-semibold mb-2"><%= t('vinyl_collection.albums.show.tracklist') %></h3>
          <table class="w-full" role="table" aria-label="<%= t('vinyl_collection.albums.show.aria.album_tracklist') %>">
            <thead class="border-b border-line">
              <tr>
                <th class="text-left pb-2 font-medium"><%= t('vinyl_collection.albums.show.position') %></th>
                <th class="text-left pb-2 font-medium"><%= t('vinyl_collection.albums.show.title_header') %></th>
                <th class="text-right pb-2 font-medium"><%= t('vinyl_collection.albums.show.duration') %></th>
              </tr>
            </thead>
            <tbody>
              <% @album.tracks.each do |track| %>
                <tr class="border-b border-line">
                  <td class="py-2 text-fg-muted"><%= track.position %></td>
                  <td class="py-2"><%= track.title %></td>
                  <td class="py-2 text-right text-fg-muted"><%= track.duration %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
      
      <% if @album.notes.present? %>
        <div class="mb-6">
          <h3 class="text-lg font-semibold mb-2"><%= t('vinyl_collection.albums.show.notes') %></h3>
          <div class="bg-surface-2 p-4 rounded-sleeve">
            <%= simple_format(@album.notes) %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="mt-6">
  <%= link_to t('vinyl_collection.albums.show.back_to_collection'), albums_path, class: "text-accent hover:underline" %>
</div>
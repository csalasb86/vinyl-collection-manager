<div class="max-w-md mx-auto bg-surface rounded-sleeve shadow-md p-6">
  <h2 class="text-2xl font-bold mb-6 text-center text-fg">Forgot your password?</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, t("vinyl_collection.auth.email"), class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field" %>
    </div>

    <div>
      <%= f.submit t("vinyl_collection.auth.send_reset"), class: "btn btn-primary btn-block" %>
    </div>
  <% end %>

  <div class="mt-6">
    <%= render "devise/shared/links" %>
  </div>
</div>

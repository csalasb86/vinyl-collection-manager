<div class="max-w-md mx-auto bg-surface rounded-sleeve shadow-md p-6">
  <h2 class="text-2xl font-bold mb-6 text-center text-fg">Change your password</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div>
      <%= f.label :password, "New password", class: "block text-sm font-medium text-fg-muted mb-1" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-fg-subtle mb-1">(<%= @minimum_password_length %> characters minimum)</p>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full px-3 py-2 border border-line rounded-sleeve focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-fg-muted mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-3 py-2 border border-line rounded-sleeve focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent" %>
    </div>

    <div>
      <%= f.submit "Change my password", class: "w-full bg-ok text-surface py-2 px-4 rounded-sleeve hover:bg-ok-hover focus:outline-none focus:ring-2 focus:ring-ok focus:ring-offset-2 transition duration-200" %>
    </div>
  <% end %>

  <div class="mt-6">
    <%= render "devise/shared/links" %>
  </div>
</div>

<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-cache="false" class="bg-danger-soft border border-line rounded-sleeve p-4 mb-4">
    <div class="flex">
      <div class="shrink-0">
        <svg class="h-5 w-5 text-danger" viewBox="0 0 20 20" fill="currentColor" aria-label="<%= t('errors.aria.error_icon') %>" role="img">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="ml-3">
        <h3 class="text-sm font-medium text-danger">
          <%= I18n.t("errors.messages.not_saved",
                     count: resource.errors.count,
                     resource: resource.class.model_name.human.downcase)
           %>
        </h3>
        <div class="mt-2 text-sm text-danger">
          <ul class="list-disc list-inside space-y-1">
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
<% end %>

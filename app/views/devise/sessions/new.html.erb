<div class="max-w-md mx-auto bg-surface rounded-sleeve shadow-md p-6">
  <h2 class="text-2xl font-bold mb-6 text-center text-fg"><%= t("vinyl_collection.auth.log_in") %></h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, t("vinyl_collection.auth.email"), class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field" %>
    </div>

    <div>
      <%= f.label :password, t("vinyl_collection.auth.password"), class: "field-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "field" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center">
        <%= f.check_box :remember_me, class: "h-4 w-4 text-accent focus:ring-accent border-line rounded-sleeve" %>
        <%= f.label :remember_me, t("vinyl_collection.auth.remember_me"), class: "ml-2 block text-sm text-fg-muted" %>
      </div>
    <% end %>

    <div>
      <%= f.submit t("vinyl_collection.auth.log_in"), class: "btn btn-primary btn-block" %>
    </div>
  <% end %>

  <div class="mt-6">
    <%= render "devise/shared/links" %>
  </div>
</div>

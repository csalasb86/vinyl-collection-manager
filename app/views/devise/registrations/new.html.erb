<div class="max-w-md mx-auto bg-surface rounded-sleeve shadow-md p-6">
  <h2 class="text-2xl font-bold mb-6 text-center text-fg">Sign up</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: form_label_classes %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: form_input_classes %>
    </div>

    <div>
      <%= f.label :password, class: form_label_classes %>
      <% if @minimum_password_length %>
        <p class="text-xs text-fg-subtle mb-1">(<%= @minimum_password_length %> characters minimum)</p>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: form_input_classes %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: form_label_classes %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: form_input_classes %>
    </div>

    <div>
      <%= f.submit "Sign up", class: success_button_classes %>
    </div>
  <% end %>

  <div class="mt-6">
    <%= render "devise/shared/links" %>
  </div>
</div>

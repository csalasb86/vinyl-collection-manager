<%# Two locales, so a segmented pair reads faster than a select. Links keep it
    working without JS; the choice is remembered in the session. %>
<div class="inline-flex rounded-sleeve border border-line overflow-hidden" role="group"
     aria-label="<%= t("vinyl_collection.nav.language") %>">
  <% I18n.available_locales.each do |locale| %>
    <% current = I18n.locale == locale %>
    <%= link_to url_for(locale: locale),
          class: [ "inline-flex items-center min-h-11 px-3 text-xs font-semibold uppercase tracking-wide",
                   current ? "bg-accent text-accent-fg" : "text-fg-muted hover:bg-surface-2 hover:text-fg" ],
          aria: { current: ("true" if current),
                  label: t("vinyl_collection.nav.switch_language", language: t("vinyl_collection.languages.#{locale}")) } do %>
      <%= locale.to_s.upcase %>
    <% end %>
  <% end %>
</div>

<%# Always rendered, even empty: the sync job appends into #toasts over a Turbo
    Stream when it finishes, so the container has to already be on the page.
    pointer-events-none keeps the empty fixed box from swallowing clicks. %>
<div id="toasts" class="toast-region pointer-events-none">
  <% if notice.present? %>
    <%= render "shared/toast", kind: :ok, message: notice, dismiss_after: 6000 %>
  <% end %>

  <% if alert.present? %>
    <%# No timeout: this one carries something still to act on. %>
    <%= render "shared/toast", kind: :error, message: alert %>
  <% end %>
</div>

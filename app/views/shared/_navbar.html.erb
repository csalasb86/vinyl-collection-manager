<nav class="bg-surface border-b border-line">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16 gap-4">
      <div class="shrink-0">
        <%= link_to "Vinyl Collection", root_path, class: "font-display text-xl font-extrabold tracking-tight text-fg" %>
      </div>
      <div class="hidden md:block">
        <div class="ml-10 flex items-baseline space-x-1">
          <%= link_to "Albums", albums_path, class: "px-3 py-2 rounded-sleeve text-fg-muted hover:bg-surface-2 hover:text-fg" %>
          <%= link_to "Search Discogs", search_discogs_albums_path, class: "px-3 py-2 rounded-sleeve text-fg-muted hover:bg-surface-2 hover:text-fg" %>
          <%= link_to "Sync Collection", sync_collection_albums_path, data: { turbo_method: :post }, class: "px-3 py-2 rounded-sleeve text-fg-muted hover:bg-surface-2 hover:text-fg" %>

          <% if user_signed_in? %>
            <% if current_user.discogs_authenticated? %>
              <span class="inline-flex items-center gap-2 px-3 py-1 text-sm text-fg-muted border border-line rounded-full">
                <span class="w-2 h-2 rounded-full bg-ok" aria-hidden="true"></span>
                <%= current_user.email %> (Discogs connected)
              </span>
            <% else %>
              <span class="inline-flex items-center gap-2 px-3 py-1 text-sm text-fg-muted border border-line rounded-full">
                <span class="w-2 h-2 rounded-full bg-fg-subtle" aria-hidden="true"></span>
                <%= current_user.email %> (Discogs not connected)
              </span>
            <% end %>

            <%= link_to "Account", edit_user_registration_path, class: "px-3 py-2 rounded-sleeve text-fg-muted hover:bg-surface-2 hover:text-fg" %>
            <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "px-3 py-2 rounded-sleeve text-fg-muted hover:bg-surface-2 hover:text-fg" %>
          <% else %>
            <%= link_to "Login", new_user_session_path, class: "px-3 py-2 rounded-sleeve text-fg-muted hover:bg-surface-2 hover:text-fg" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "px-3 py-2 rounded-sleeve text-fg-muted hover:bg-surface-2 hover:text-fg" %>
          <% end %>
        </div>
      </div>

      <%# Kept outside the md:block wrapper so the toggle is reachable on
          phones too, until the mobile menu lands in the next phase. %>
      <button type="button"
              data-controller="theme"
              data-action="click->theme#toggle"
              aria-pressed="false"
              aria-label="Switch theme"
              class="inline-flex items-center gap-2 px-3 py-2 rounded-sleeve border border-line text-fg-muted hover:bg-surface-2 hover:text-fg">
        <svg data-theme-target="iconLight" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"/>
          <path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"/>
        </svg>
        <svg data-theme-target="iconDark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden>
          <path d="M20 14.5A8.3 8.3 0 019.5 4a8.5 8.5 0 1010.5 10.5z"/>
        </svg>
        <span data-theme-target="label" class="text-sm">Light</span>
      </button>
    </div>
  </div>
</nav>

<nav class="bg-surface border-b border-line"
     data-controller="drawer"
     data-drawer-open-label-value="<%= t("vinyl_collection.nav.open_menu") %>"
     data-drawer-close-label-value="<%= t("vinyl_collection.nav.close_menu") %>">
  <div class="container mx-auto px-4">
    <div class="flex items-center h-16 gap-3">
      <%= link_to root_path, class: "flex items-center gap-2 shrink-0 min-h-11 font-display text-xl font-extrabold tracking-tight text-fg" do %>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="10" cy="10" r="5.5" stroke="currentColor" stroke-width="1" opacity="0.45"/>
          <circle cx="10" cy="10" r="1.6" fill="currentColor"/>
        </svg>
        <%= t("vinyl_collection.nav.brand") %>
      <% end %>

      <div class="hidden md:flex items-center gap-1 ml-4">
        <%= nav_link_to t("vinyl_collection.nav.collection"), albums_path %>
        <%= nav_link_to t("vinyl_collection.nav.search_discogs"), search_discogs_albums_path %>
      </div>

      <div class="flex-1"></div>

      <% if user_signed_in? %>
        <div class="hidden lg:block">
          <%= render "shared/discogs_status" %>
        </div>
      <% end %>

      <div class="hidden sm:block">
        <%= render "shared/locale_picker" %>
      </div>

      <button type="button"
              data-controller="theme"
              data-action="click->theme#toggle"
              data-theme-light-label-value="<%= t("vinyl_collection.nav.theme_light") %>"
              data-theme-dark-label-value="<%= t("vinyl_collection.nav.theme_dark") %>"
              data-theme-to-light-label-value="<%= t("vinyl_collection.nav.switch_to_light") %>"
              data-theme-to-dark-label-value="<%= t("vinyl_collection.nav.switch_to_dark") %>"
              aria-pressed="false"
              aria-label="<%= t("vinyl_collection.nav.switch_theme") %>"
              class="control border border-line text-fg-muted hover:bg-surface-2 hover:text-fg">
        <svg data-theme-target="iconLight" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"/>
          <path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"/>
        </svg>
        <svg data-theme-target="iconDark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden>
          <path d="M20 14.5A8.3 8.3 0 019.5 4a8.5 8.5 0 1010.5 10.5z"/>
        </svg>
        <span data-theme-target="label" class="text-sm"><%= t("vinyl_collection.nav.theme_light") %></span>
      </button>

      <% if user_signed_in? %>
        <%# The email lives in this menu instead of the bar, where a long
            address used to stretch the layout. %>
        <div class="relative hidden md:block" data-controller="dropdown">
          <button type="button"
                  data-dropdown-target="button"
                  data-action="dropdown#toggle"
                  aria-haspopup="menu"
                  aria-expanded="false"
                  aria-label="<%= t("vinyl_collection.nav.account_menu") %>"
                  class="flex items-center justify-center w-11 h-11 rounded-full border border-line bg-accent-soft text-accent text-xs font-semibold hover:border-accent">
            <%= avatar_initials(current_user) %>
          </button>

          <div data-dropdown-target="menu" hidden role="menu"
               class="absolute right-0 mt-2 w-64 bg-surface border border-line rounded-sleeve shadow-md z-50 py-1">
            <p class="px-3 py-2 border-b border-line text-xs text-fg-subtle truncate" title="<%= current_user.email %>">
              <%= current_user.email %>
            </p>

            <div class="lg:hidden px-3 py-2 border-b border-line">
              <%= render "shared/discogs_status" %>
            </div>

            <%= button_to t("vinyl_collection.nav.sync"), sync_collection_albums_path,
                  form_class: "contents",
                  role: "menuitem",
                  data: {
                    turbo_confirm: t("vinyl_collection.nav.sync_confirm"),
                    turbo_submits_with: t("vinyl_collection.nav.syncing")
                  },
                  class: "flex items-center w-full min-h-11 text-left px-3 py-2 text-sm text-fg-muted hover:bg-surface-2 hover:text-fg" %>

            <p class="px-3 pb-2 -mt-1 font-mono text-xs text-fg-subtle"><%= last_sync_label(current_user) %></p>

            <%= link_to t("vinyl_collection.nav.account"), edit_user_registration_path,
                  role: "menuitem",
                  class: "flex items-center min-h-11 px-3 py-2 text-sm text-fg-muted hover:bg-surface-2 hover:text-fg" %>

            <%= button_to t("vinyl_collection.nav.log_out"), destroy_user_session_path,
                  method: :delete,
                  form_class: "contents",
                  role: "menuitem",
                  class: "flex items-center w-full min-h-11 text-left px-3 py-2 text-sm text-fg-muted hover:bg-surface-2 hover:text-fg" %>
          </div>
        </div>
      <% end %>

      <%# Below md this is the only way into the rest of the app. %>
      <button type="button"
              data-drawer-target="button"
              data-action="drawer#toggle"
              aria-expanded="false"
              aria-controls="mobile-menu"
              aria-label="<%= t("vinyl_collection.nav.open_menu") %>"
              class="md:hidden control-icon border border-line text-fg-muted hover:bg-surface-2 hover:text-fg">
        <svg data-drawer-target="iconOpen" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
        <svg data-drawer-target="iconClose" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden>
          <path d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu"
       data-drawer-target="panel"
       data-action="click->drawer#closeOnNavigate"
       hidden
       class="md:hidden border-t border-line bg-surface">
    <div class="container mx-auto px-4 py-3 flex flex-col gap-1">
      <%= nav_link_to t("vinyl_collection.nav.collection"), albums_path, mobile: true %>
      <%= nav_link_to t("vinyl_collection.nav.search_discogs"), search_discogs_albums_path, mobile: true %>

      <% if user_signed_in? %>
        <hr class="my-2 border-line">

        <%= button_to t("vinyl_collection.nav.sync"), sync_collection_albums_path,
              form_class: "contents",
              data: {
                turbo_confirm: t("vinyl_collection.nav.sync_confirm"),
                turbo_submits_with: t("vinyl_collection.nav.syncing")
              },
              class: "flex items-center min-h-11 px-3 py-2 rounded-sleeve text-base text-fg-muted hover:bg-surface-2 hover:text-fg" %>

        <%= nav_link_to t("vinyl_collection.nav.account"), edit_user_registration_path, mobile: true %>

        <%= button_to t("vinyl_collection.nav.log_out"), destroy_user_session_path,
              method: :delete,
              form_class: "contents",
              class: "flex items-center min-h-11 px-3 py-2 rounded-sleeve text-base text-fg-muted hover:bg-surface-2 hover:text-fg" %>

        <hr class="my-2 border-line">

        <div class="px-3 pb-2 text-fg-muted">
          <%= render "shared/discogs_status" %>
          <p class="mt-2 font-mono text-xs text-fg-subtle"><%= last_sync_label(current_user) %></p>
          <p class="mt-1 text-xs text-fg-subtle truncate"><%= current_user.email %></p>
          <div class="mt-3 sm:hidden"><%= render "shared/locale_picker" %></div>
        </div>
      <% end %>
    </div>
  </div>
</nav>

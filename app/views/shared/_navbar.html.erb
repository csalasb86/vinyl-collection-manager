<nav class="bg-gray-900 text-white">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <div class="flex-shrink-0">
        <%= link_to "Vinyl Collection", root_path, class: "text-xl font-bold" %>
      </div>
      <div class="hidden md:block">
        <div class="ml-10 flex items-baseline space-x-4">
          <%= link_to "Albums", albums_path, class: "hover:bg-gray-700 px-3 py-2 rounded-md" %>
          <%= link_to "Search Discogs", search_discogs_albums_path, class: "hover:bg-gray-700 px-3 py-2 rounded-md" %>
          <%= link_to "Sync Collection", sync_collection_albums_path, data: { turbo_method: :post }, class: "hover:bg-gray-700 px-3 py-2 rounded-md" %>
          
          <% if user_signed_in? %>
            <% if current_user.discogs_authenticated? %>
              <span class="text-green-400"><%= current_user.email %> (Discogs Connected)</span>
            <% else %>
              <span class="text-yellow-400"><%= current_user.email %> (Discogs Not Connected)</span>
            <% end %>
            
            <%= link_to "Account", edit_user_registration_path, class: "hover:bg-gray-700 px-3 py-2 rounded-md" %>
            <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "hover:bg-gray-700 px-3 py-2 rounded-md" %>
          <% else %>
            <%= link_to "Login", new_user_session_path, class: "hover:bg-gray-700 px-3 py-2 rounded-md" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "hover:bg-gray-700 px-3 py-2 rounded-md" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</nav>
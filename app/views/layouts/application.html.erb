<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Vinyl Collection Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <% unless Rails.env.test? %>
      <%= stylesheet_link_tag "tailwind", "data-turbo-track" => "reload" %>
    <% end %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 min-h-screen">
    <%= render 'shared/navbar' %>
    
    <% if notice %>
      <div class="p-4 mb-4 bg-green-100 text-green-800">
        <%= notice %>
      </div>
    <% end %>
    
    <% if alert %>
      <div class="p-4 mb-4 bg-red-100 text-red-800">
        <%= alert %>
      </div>
    <% end %>
    
    <main class="container mx-auto px-4 py-6">
      <%= yield %>
    </main>
    
    <footer class="bg-gray-900 text-white p-6 mt-12">
      <div class="container mx-auto">
        <p class="text-center">Vinyl Collection Manager</p>
      </div>
    </footer>
  </body>
</html>

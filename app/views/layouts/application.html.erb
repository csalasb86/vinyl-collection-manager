<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Vinyl Collection Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="color-scheme" content="light dark">

    <%# Applies the saved theme before first paint so the page never flashes
        the wrong palette. Must stay inline and ahead of the stylesheet. %>
    <script>
      (function () {
        var stored;
        try { stored = localStorage.getItem("theme"); } catch (e) {}
        if (stored !== "light" && stored !== "dark") {
          stored = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = stored;
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Instrument+Sans:wght@400..600&family=IBM+Plex+Mono:wght@400;500&display=swap">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <% unless Rails.env.test? %>
      <link rel="stylesheet" href="<%= asset_path('tailwind.css') %>" data-turbo-track="reload">
    <% end %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= body_css_classes %>">
    <% if show_auth_layout? %>
      <main class="w-full max-w-md">
        <%= render 'shared/flash_messages' %>
        <%= yield %>
      </main>
    <% elsif show_authenticated_layout? %>
      <%= link_to "Skip to content", "#main", class: "skip-link" %>
      <%= render 'shared/navbar' %>
      <%= render 'shared/flash_messages' %>

      <main id="main" class="container mx-auto px-4 py-6">
        <%= yield %>
      </main>

      <footer class="mt-12 border-t border-line py-6 text-fg-subtle">
        <div class="container mx-auto px-4">
          <p class="text-center text-sm">Vinyl Collection Manager</p>
        </div>
      </footer>
    <% else %>
      <main class="w-full max-w-md">
        <%= render 'shared/flash_messages' %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
